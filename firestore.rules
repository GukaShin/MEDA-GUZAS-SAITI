rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email in ['guka@meda-guza.app', 'guza@meda-guza.app'];
    }

    function isOwner(user) {
      return isMember() && request.auth.token.email == user + '@meda-guza.app';
    }

    match /progress/{user} {
      allow read: if isMember();
      allow create, update: if isOwner(user)
        && request.resource.data.keys().hasOnly(['startDate', 'days', 'updatedAt'])
        && request.resource.data.startDate is string
        && request.resource.data.days is map;
      allow delete: if isOwner(user);
    }
  }
}
